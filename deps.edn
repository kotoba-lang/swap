;; swap — provider-agnostic swap core: intent, normalized quote, execution plan
;; as DATA, safety invariants, and fee accounting. Two rails (EVM aggregator and
;; native cross-chain via THORChain) reduced to one shape.
;;
;; NOTHING HERE SIGNS OR SENDS: a plan is a value an executor carries out, so the
;; whole interesting half is testable without a network, a key, or a chain.
{:paths ["src"]
 :deps {io.github.kotoba-lang/erc20
        {:git/sha "7229206b9118ee55b4582d2d102912a5140a6265"}
        io.github.kotoba-lang/org-thorchain
        {:git/sha "4e2ad219716f5d8582c19a370a8571900be72956"}
        io.github.kotoba-lang/treasury
        {:git/sha "9aafa2f188de8c84046f8b5d8bdc166002159277"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
