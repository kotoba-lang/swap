;; swap — provider-agnostic swap core: intent, normalized quote, execution plan
;; as DATA, safety invariants, and fee accounting. Two rails (EVM aggregator and
;; native cross-chain via THORChain) reduced to one shape.
;;
;; NOTHING HERE SIGNS OR SENDS: a plan is a value an executor carries out, so the
;; whole interesting half is testable without a network, a key, or a chain.
{:paths ["src"]
 :deps {io.github.kotoba-lang/erc20
        {:git/sha "7229206b9118ee55b4582d2d102912a5140a6265"}
        io.github.kotoba-lang/org-thorchain
        {:git/sha "dda03d694f2c52ea06b7c657586b5c70ba12c8f6"}
        io.github.kotoba-lang/treasury
        {:git/sha "18b873b8c3645c592befa66d2e9e187729d4118e"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; eth-crypto is a TEST/DEV-only dependency: swap never signs anything,
         ;; but bin/verify_live.cljs uses it to check a locally built EIP-712
         ;; domain separator against a deployed token's on-chain DOMAIN_SEPARATOR().
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/eth-crypto
                      {:git/sha "1dca359cdff08a729f20b935f04390c8c04d262b"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
